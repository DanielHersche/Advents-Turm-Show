{
    "name": "Turm-Show Adventskerzen",
    "options": [
        {
            "title": "Betrieb",
            "type": "section"
        },
        {
            "title": "Betriebsart",
            "name": "betrieb",
            "type": "select",
            "default": "auto",
            "options": [
                [
                    "auto",
                    "Automatik nach Kalender"
                ],
                [
                    "an",
                    "Dauerbetrieb (Test, Satz unten)"
                ],
                [
                    "aus",
                    "Beamer immer im Standby"
                ]
            ]
        },
        {
            "title": "Satz fuer Test und Einmessen",
            "name": "test_set",
            "type": "select",
            "default": 1,
            "options": [
                [
                    1,
                    "K1 - eine Kerze"
                ],
                [
                    2,
                    "K2 - zwei Kerzen"
                ],
                [
                    3,
                    "K3 - drei Kerzen"
                ],
                [
                    4,
                    "K4 - vier Kerzen"
                ]
            ]
        },
        {
            "title": "Anzeige",
            "name": "anzeige",
            "type": "select",
            "default": "play",
            "options": [
                [
                    "play",
                    "Betrieb"
                ],
                [
                    "measure",
                    "1 Messraster (ohne Korrektur)"
                ],
                [
                    "check",
                    "2 Pruefraster (mit Korrektur)"
                ],
                [
                    "both",
                    "3 Video + Pruefraster"
                ]
            ]
        },
        {
            "title": "Kalender (Datum JJJJ-MM-TT, Zeit HH:MM oder HH:MM:SS)",
            "type": "section"
        },
        {
            "title": "K1 ab Datum",
            "name": "k1_start",
            "type": "string",
            "default": "2026-12-01"
        },
        {
            "title": "K2 ab Datum",
            "name": "k2_start",
            "type": "string",
            "default": "2026-12-06"
        },
        {
            "title": "K3 ab Datum",
            "name": "k3_start",
            "type": "string",
            "default": "2026-12-13"
        },
        {
            "title": "K4 ab Datum",
            "name": "k4_start",
            "type": "string",
            "default": "2026-12-20"
        },
        {
            "title": "Letzter Showtag",
            "name": "end_date",
            "type": "string",
            "default": "2026-12-24"
        },
        {
            "title": "Morgen: Start",
            "name": "m_start",
            "type": "string",
            "default": "06:00"
        },
        {
            "title": "Morgen: Ende (Outro beginnt)",
            "name": "m_end",
            "type": "string",
            "default": "08:00"
        },
        {
            "title": "Abend: Start",
            "name": "a_start",
            "type": "string",
            "default": "16:45"
        },
        {
            "title": "Abend: Ende (Outro beginnt)",
            "name": "a_end",
            "type": "string",
            "default": "22:00"
        },
        {
            "title": "Filme K1 (eine Kerze)",
            "type": "section"
        },
        {
            "title": "K1 Intro (einmal beim Einschalten)",
            "name": "k1_intro",
            "type": "resource",
            "valid": [
                "video",
                "image"
            ],
            "default": "empty.png",
            "features": [
                "h264",
                "hevc",
                "image2k"
            ]
        },
        {
            "title": "K1 Loop (laeuft nahtlos bis Fensterende)",
            "name": "k1_loop",
            "type": "resource",
            "valid": [
                "video",
                "image"
            ],
            "default": "empty.png",
            "features": [
                "h264",
                "hevc",
                "image2k"
            ]
        },
        {
            "title": "K1 Outro (einmal beim Ausschalten)",
            "name": "k1_outro",
