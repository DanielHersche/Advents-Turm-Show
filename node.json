        },
        {
            "title": "Uebergaenge",
            "type": "section"
        },
        {
            "title": "Ueberblendung (Sekunden)",
            "name": "fade",
            "type": "float",
            "default": 1.0
        },
        {
            "title": "Laenge Loop-Film in Sek. (0 = Outro sofort, sonst am Loop-Ende schneiden)",
            "name": "loop_length",
            "type": "float",
            "default": 0
        },
        {
            "title": "Beamer ein/aus",
            "type": "section"
        },
        {
            "title": "Vorlauf: Beamer so viele Sekunden vor Showbeginn einschalten",
            "name": "vorlauf",
            "type": "integer",
            "default": 60
        },
        {
            "title": "Nachlauf: Beamer so viele Sekunden nach Fensterende in Standby (laenger als Outro!)",
            "name": "nachlauf",
            "type": "integer",
            "default": 120
        },
        {
            "title": "HDMI-CEC verwenden (tv on / tv off)",
            "name": "cec",
            "type": "boolean",
            "default": true
        },
        {
            "title": "PJLink: IP-Adresse des Beamers (leer = kein PJLink)",
            "name": "pjlink_ip",
            "type": "string",
            "default": ""
        },
        {
            "title": "PJLink: Passwort",
            "name": "pjlink_pw",
            "type": "string",
            "default": ""
        },
        {
            "title": "Geometrie",
            "type": "section"
        },
        {
            "title": "Bildschirm-Drehung (nur ohne Vier-Ecken-Korrektur)",
            "name": "rotation",
            "type": "select",
            "default": 0,
            "options": [
                [
                    0,
                    "0 Grad (keine)"
                ],
                [
                    90,
                    "90 Grad"
                ],
                [
                    180,
                    "180 Grad"
                ],
                [
                    270,
                    "270 Grad"
                ]
            ]
        },
        {
            "title": "Vier-Ecken-Korrektur aktiv",
            "name": "corner",
            "type": "boolean",
            "default": false
        },
        {
            "title": "Oben links x",
            "name": "ol_x",
            "type": "float",
            "default": 0.0
        },
        {
            "title": "Oben links y",
            "name": "ol_y",
            "type": "float",
            "default": 0.0
        },
        {
            "title": "Oben rechts x",
            "name": "or_x",
            "type": "float",
            "default": 1.0
        },
        {
            "title": "Oben rechts y",
            "name": "or_y",
            "type": "float",
            "default": 0.0
        },
        {
            "title": "Unten rechts x",
            "name": "ur_x",
            "type": "float",
            "default": 1.0
        },
        {
            "title": "Unten rechts y",
            "name": "ur_y",
            "type": "float",
            "default": 1.0
        },
        {
            "title": "Unten links x",
            "name": "ul_x",
            "type": "float",
            "default": 0.0
        },
        {
            "title": "Unten links y",
            "name": "ul_y",
            "type": "float",
            "default": 1.0
        },
        {
            "title": "Kantenweichheit",
            "name": "soft",
            "type": "float",
            "default": 0.002
        },
        {
            "title": "Helligkeit (1.0 = unveraendert)",
            "name": "gain",
            "type": "float",
            "default": 1.0
        },
        {
            "title": "Ausweichweg ueber Snapshot",
            "name": "snapshot",
            "type": "boolean",
            "default": false
        }
    ],
    "permissions": {
        "network": "PJLink: Beamer im lokalen Netz ein- und ausschalten (TCP-Port 4352)"
    }
}
