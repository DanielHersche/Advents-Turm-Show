#!/usr/bin/python2.7
# -*- coding: utf-8 -*-
# Turm-Show Adventskerzen - Kalender und Beamersteuerung
#
# Entscheidet anhand von Datum und Uhrzeit:
#   - welcher Kerzen-Satz (K1..K4) laeuft und ob gerade Show ist -> Meldung an node.lua
#   - ob der Beamer an oder im Standby sein soll -> HDMI-CEC ("tv on/off") und/oder PJLink ueber LAN
#
# Zeitlicher Ablauf je Zeitfenster (Beispiel Abend 16:45-22:00, Vorlauf 60 s, Nachlauf 120 s):
#   16:44:00  Beamer aus dem Standby holen (Bild schwarz)
#   16:45:00  Intro startet, danach Loop
#   22:00:00  Outro startet (bzw. am naechsten Loop-Ende, siehe node.lua)
#   22:02:00  Beamer in den Standby
import os, sys, json, time, socket, hashlib
from datetime import datetime, timedelta, date

try:
    import pytz
except Exception:
    pytz = None

SET_KEYS = ("k1_start", "k2_start", "k3_start", "k4_start")


def log(msg):
    sys.stderr.write("[turm-show] %s\n" % (msg,))
    sys.stderr.flush()


def load_config():
    try:
        with open("config.json") as f:
            return json.load(f)
    except Exception as err:
        log("config.json nicht lesbar: %s" % (err,))
        return {}


# --- Hilfsfunktionen fuer Datum und Zeit ------------------------------------

def parse_hms(value):
    """'16:45', '16.45' oder '21:59:30' -> Sekunden seit Mitternacht (oder None)."""
    try:
        parts = [int(p) for p in str(value).strip().replace(".", ":").split(":")]
        if len(parts) == 2:
            parts.append(0)
        h, m, s = parts
        if 0 <= h <= 24 and 0 <= m <= 59 and 0 <= s <= 59:
            return h * 3600 + m * 60 + s
    except Exception:
        pass
    return None


def parse_date(value):
    """'2026-12-01' oder '1.12.2026' -> date (oder None)."""
    value = str(value or "").strip()
    for fmt in ("%Y-%m-%d", "%d.%m.%Y"):
        try:
            return datetime.strptime(value, fmt).date()
        except Exception:
            pass
    return None


def _last_sunday(year, month):
    d = date(year, month + 1, 1) - timedelta(days=1) if month < 12 else date(year, 12, 31)
    return d - timedelta(days=(d.weekday() + 1) % 7)


def zurich_now_fallback():
    """Mitteleuropaeische Zeit ohne pytz: MEZ, MESZ vom letzten Maerz- bis zum letzten Oktobersonntag (01:00 UTC)."""
    utc = datetime.utcnow()
    start = datetime.combine(_last_sunday(utc.year, 3), datetime.min.time()) + timedelta(hours=1)
    end = datetime.combine(_last_sunday(utc.year, 10), datetime.min.time()) + timedelta(hours=1)
    offset = 2 if start <= utc < end else 1
    return utc + timedelta(hours=offset)


def local_now(config):
    tzname = (config.get("__metadata") or {}).get("timezone") or "Europe/Zurich"
    if pytz is not None:
        try:
            tz = pytz.timezone(tzname)
        except Exception:
            tz = pytz.timezone("Europe/Zurich")
        return pytz.utc.localize(datetime.utcnow()).astimezone(tz).replace(tzinfo=None)
    return zurich_now_fallback()


# --- Kalender ----------------------------------------------------------------

def active_set(config, day):
    """Satz 1..4, der an diesem Tag gilt (0 = kein Showtag)."""
    end = parse_date(config.get("end_date"))
    if end and day > end:
        return 0
    best, best_date = 0, None
    for n, key in enumerate(SET_KEYS, 1):
        d = parse_date(config.get(key))
        if d and d <= day and (best_date is None or d >= best_date):
            best, best_date = n, d
    return best


def windows(config):
    result = []
    for a_key, b_key in (("m_start", "m_end"), ("a_start", "a_end")):
        a, b = parse_hms(config.get(a_key)), parse_hms(config.get(b_key))
        if a is not None and b is not None and b > a:
            result.append((a, b))
    return result


def plan(config, now):
    """-> (prog, beamer_an, beschreibung)
    prog 0 = keine Show, 1..4 = Show mit Satz K1..K4"""
    betrieb = config.get("betrieb", "auto")
    anzeige = config.get("anzeige", "play")
    try:
        test_set = int(config.get("test_set", 1))
    except Exception:
        test_set = 1

    if anzeige != "play":
        return test_set, True, "Einmessen (%s), Satz K%d" % (anzeige, test_set)
    if betrieb == "an":
        return test_set, True, "Dauerbetrieb, Satz K%d" % test_set
    if betrieb == "aus":
        return 0, False, "Beamer immer aus"

    vor = int(config.get("vorlauf", 60) or 0)
    nach = int(config.get("nachlauf", 120) or 0)
    sec = now.hour * 3600 + now.minute * 60 + now.second
    n = active_set(config, now.date())
    prog, beamer = 0, False
    if n:
        for a, b in windows(config):
            if a <= sec < b:
                prog = n
            if a - vor <= sec < b + nach:
                beamer = True
    if prog:
        text = "Show K%d" % prog
    elif beamer:
        text = "Vor-/Nachlauf (Beamer an, Bild schwarz)"
    elif n:
        text = "Showtag K%d, ausserhalb der Zeitfenster" % n
    else:
        text = "kein Showtag"
    return prog, beamer, text


# --- Ausgaenge ---------------------------------------------------------------

def syncer(cmd):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(os.getenv("SYNCER_SOCKET", "/tmp/syncer"))
        s.send(cmd + "\n")
        s.close()
    except Exception as err:
        log("Befehl '%s' fehlgeschlagen: %s" % (cmd, err))


udp = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)


def node_send(key, value):
    try:
        udp.sendto("%s/%s:%s" % (os.getenv("NODE", "root"), key, value),
                   ("127.0.0.1", 4444))
    except Exception as err:
        log("Senden an Node fehlgeschlagen: %s" % (err,))


def _readline(s):
    buf = ""
    while not buf.endswith("\r"):
        chunk = s.recv(256)
        if not chunk:
            break
        buf += chunk
    return buf.strip()


def pjlink(ip, password, cmd):
    """Einen PJLink-Befehl senden (Port 4352), Antwort zurueckgeben."""
    s = socket.create_connection((ip, 4352), timeout=5)
    try:
        greet = _readline(s)
        prefix = ""
        if greet.startswith("PJLINK 1"):
            prefix = hashlib.md5(greet.split()[2] + (password or "")).hexdigest()
        elif not greet.startswith("PJLINK 0"):
            raise Exception("unerwartete Begruessung: %r" % greet)
        s.sendall(prefix + cmd + "\r")
        answer = _readline(s)
        if answer.startswith("PJLINK ERRA"):
            raise Exception("PJLink-Passwort falsch")
        return answer
    finally:
        s.close()


def pjlink_ensure(config, want_on):
    ip = str(config.get("pjlink_ip", "") or "").strip()
    if not ip:
        return
    pw = str(config.get("pjlink_pw", "") or "")
    try:
        status = pjlink(ip, pw, "%1POWR ?").split("=")[-1]
        # 0 Standby, 1 an, 2 kuehlt ab, 3 waermt auf
        if want_on and status == "0":
            log("PJLink: Beamer einschalten -> %s" % pjlink(ip, pw, "%1POWR 1"))
        elif not want_on and status in ("1", "3"):
            log("PJLink: Beamer in Standby -> %s" % pjlink(ip, pw, "%1POWR 0"))
    except Exception as err:
        log("PJLink %s nicht erreichbar: %s" % (ip, err))


# --- Hauptschleife -----------------------------------------------------------

def main():
    node_send("prog", 0)
    while time.time() < 1000000000:
        log("warte auf korrekte Systemzeit")
        node_send("prog", 0)
        time.sleep(5)

    last = (None, None)
    last_cec = 0
    last_pjlink = 0
    while True:
        config = load_config()
        now = local_now(config)
        prog, beamer_on, text = plan(config, now)
        node_send("prog", prog)

        changed = (prog, beamer_on) != last
        if changed:
            log("%s -> %s | Beamer %s" % (now.strftime("%Y-%m-%d %H:%M:%S"), text,
                                          "an" if beamer_on else "Standby"))

        beamer_changed = beamer_on != last[1]
        use_cec = config.get("cec", True)
        if use_cec and (beamer_changed or time.time() - last_cec > 600):
            syncer("tv on" if beamer_on else "tv off")
            last_cec = time.time()
        if beamer_changed or time.time() - last_pjlink > 30:
            pjlink_ensure(config, beamer_on)
            last_pjlink = time.time()

        last = (prog, beamer_on)
        time.sleep(2)


if __name__ == "__main__":
    main()
